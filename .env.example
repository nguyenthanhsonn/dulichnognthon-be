PORT=3000

# Replace with the connection URL for your existing PostgreSQL database.
# URL-encode special characters in the username/password.
# Example: postgresql://username:password@localhost:5432/dulich
# Append ?sslmode=verify-full if your database provider requires verified TLS.
DATABASE_URL=

# Chỉ điền lịch chính thức; để trống sẽ đóng chức năng bình chọn.
# Giờ mở/đóng trong giai đoạn 05–20/11/2026 cần Ban tổ chức xác nhận.
# Dùng ISO 8601 kèm timezone, ví dụ 2026-11-05T00:00:00+07:00.
VOTING_START_AT=
VOTING_END_AT=
MAX_VOTES_PER_USER=3
OTP_EXPIRES_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_SEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# Sinh riêng từng secret bằng: openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_OTP_SECRET=

# Email OTP: smtp cho Gmail/local; resend cho Render Free qua HTTPS.
EMAIL_PROVIDER=smtp
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Gmail dùng App Password, không dùng mật khẩu đăng nhập tài khoản.
SMTP_PASS=
RESEND_API_KEY=

# Local không có reverse proxy. Render đặt biến này thành 1.
TRUST_PROXY_HOPS=0
